{
  "name": "CORTEX",
  "version": "1.0.0",
  "description": "CORe + TEX - Unified AI Agent System (DORY + PULSE)",
  "components": {
    "dory": {
      "path": "./dory",
      "type": "nvidia-nim",
      "description": "Deep Orchestration & Reasoning sYstem",
      "entry": {
        "web": "npm run dev",
        "mcp": "npx tsx mcp-server.ts"
      },
      "port": 3000,
      "requires": ["NVIDIA_API_KEY"]
    },
    "pulse": {
      "path": "./pulse",
      "type": "codex-agent",
      "description": "Persistent Unified Learning Session Engine",
      "entry": {
        "build": "python autoogpt.py -p <project>",
        "qa": "python autoqagpt.py -p <project>"
      },
      "install_to": "~/.codex",
      "requires": ["OPENAI_API_KEY"]
    }
  },
  "integration": {
    "mcp_bridge": {
      "enabled": true,
      "server": "dory",
      "client": "pulse",
      "config_path": "~/.codex/config.toml"
    },
    "shared_memory": {
      "dory": "~/.nvidia-cli/memory/vector-memory.json",
      "pulse": "~/.codex/memory/anchor.md"
    }
  },
  "models": {
    "nvidia": {
      "llm": "nvidia/nemotron-3-nano-30b-a3b",
      "embeddings": "nvidia/llama-3.2-nv-embedqa-1b-v2",
      "reranker": "nvidia/llama-3.2-nv-rerankqa-1b-v2",
      "vision": "nvidia/nemotron-nano-12b-v2-vl"
    }
  }
}
